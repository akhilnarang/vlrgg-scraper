[Unit]
Description=VLR.gg Scraper
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/vlrgg-scraper
# The app loads its own .env from the working directory (pydantic-settings).
# --no-sync: do not touch the venv at start. The installer and deploy.sh run
# `uv sync` in the user's environment instead.
ExecStart=%h/.local/bin/uv run --no-sync uvicorn app.main:app --uds %h/vlrgg-scraper/gunicorn.sock
Restart=always
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target
